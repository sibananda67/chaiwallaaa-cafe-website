<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1000" width="1600" height="1000" fill="none">
  <defs>
    <!-- Night sky gradient -->
    <radialGradient id="night-bg" cx="50%" cy="30%" r="80%">
      <stop offset="0%" stopColor="#251610" />
      <stop offset="40%" stopColor="#180F0B" />
      <stop offset="80%" stopColor="#0F0906" />
      <stop offset="100%" stopColor="#080504" />
    </radialGradient>

    <!-- Warm bulb glow -->
    <radialGradient id="edison-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stopColor="#FFFDF0" />
      <stop offset="20%" stopColor="#FFDC73" stopOpacity="0.95" />
      <stop offset="50%" stopColor="#FF9E1B" stopOpacity="0.5" />
      <stop offset="80%" stopColor="#E65100" stopOpacity="0.15" />
      <stop offset="100%" stopColor="#E65100" stopOpacity="0" />
    </radialGradient>

    <!-- Thatch roof texture gradient -->
    <linearGradient id="thatch-night" x1="0%" y1="0%" x2="100%" y2="50%">
      <stop offset="0%" stopColor="#5D4037" />
      <stop offset="50%" stopColor="#8D6E63" />
      <stop offset="100%" stopColor="#3E2723" />
    </linearGradient>

    <!-- Gravel floor under night lighting -->
    <linearGradient id="gravel-night" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stopColor="#2B1D15" />
      <stop offset="50%" stopColor="#3E2E23" />
      <stop offset="100%" stopColor="#4A382A" />
    </linearGradient>
  </defs>

  <!-- Night Background -->
  <rect width="1600" height="1000" fill="url(#night-bg)" />

  <!-- Distant night greenery & ambient glow -->
  <path d="M 0 520 Q 400 480 800 510 T 1600 490 L 1600 680 L 0 680 Z" fill="#130D08" />

  <!-- Outdoor gravel floor illuminated by warm light -->
  <path d="M 0 620 L 1600 620 L 1600 1000 L 0 1000 Z" fill="url(#gravel-night)" />
  <!-- Gravel stones texture -->
  <g opacity="0.35">
    <circle cx="200" cy="740" r="6" fill="#A1887F" />
    <circle cx="380" cy="850" r="8" fill="#5D4037" />
    <circle cx="620" cy="780" r="7" fill="#8D6E63" />
    <circle cx="920" cy="910" r="10" fill="#3E2723" />
    <circle cx="1200" cy="820" r="7" fill="#BCAAA4" />
    <circle cx="1420" cy="890" r="8" fill="#6D4C41" />
  </g>

  <!-- Thatched Umbrella Cabana Canopy (Upper frame) -->
  <g id="thatched-canopy">
    <path d="M -100 -50 L 520 220 C 440 260, 240 280, 0 280 Z" fill="url(#thatch-night)" />
    <!-- Straw fringes -->
    <path d="M -50 240 Q 150 290 350 260 T 520 220" stroke="#D7CCC8" stroke-width="8" stroke-dasharray="14,10" fill="none" />
    <path d="M 0 220 Q 200 270 450 230" stroke="#8D6E63" stroke-width="10" stroke-dasharray="18,12" fill="none" />

    <!-- Fairy lights lining the thatch rim -->
    <circle cx="50" cy="265" r="18" fill="url(#edison-glow)" />
    <circle cx="150" cy="275" r="22" fill="url(#edison-glow)" />
    <circle cx="260" cy="270" r="20" fill="url(#edison-glow)" />
    <circle cx="370" cy="255" r="19" fill="url(#edison-glow)" />
    <circle cx="480" cy="235" r="16" fill="url(#edison-glow)" />
  </g>

  <!-- Steel Support Beams & Festoon Wires Across Evening Sky -->
  <path d="M 0 180 Q 400 320 800 290 T 1600 240" stroke="#0D0704" stroke-width="3" fill="none" />
  <path d="M 200 120 Q 700 280 1200 250 T 1600 220" stroke="#0D0704" stroke-width="2.5" fill="none" />

  <!-- Suspended Edison Filament Bulbs Glowing in Darkness -->
  <!-- Bulb 1 (Left foreground) -->
  <g transform="translate(240, 290)">
    <line x1="0" y1="-80" x2="0" y2="0" stroke="#120A05" stroke-width="2.5" />
    <rect x="-8" y="-12" width="16" height="14" rx="2" fill="#B08D57" />
    <circle cx="0" cy="30" r="120" fill="url(#edison-glow)" />
    <ellipse cx="0" cy="18" rx="14" ry="22" fill="#FFF8E1" opacity="0.9" />
    <path d="M -4 8 L 0 24 L 4 8" stroke="#FF6F00" stroke-width="2" fill="none" />
  </g>

  <!-- Bulb 2 (Center dominant) -->
  <g transform="translate(720, 270)">
    <line x1="0" y1="-100" x2="0" y2="0" stroke="#120A05" stroke-width="2.5" />
    <rect x="-9" y="-14" width="18" height="16" rx="2" fill="#B08D57" />
    <circle cx="0" cy="35" r="140" fill="url(#edison-glow)" />
    <ellipse cx="0" cy="22" rx="16" ry="26" fill="#FFF9C4" opacity="0.95" />
    <path d="M -5 10 L 0 30 L 5 10" stroke="#FF6F00" stroke-width="2.5" fill="none" />
  </g>

  <!-- Bulb 3 (Mid right) -->
  <g transform="translate(1180, 260)">
    <line x1="0" y1="-90" x2="0" y2="0" stroke="#120A05" stroke-width="2.5" />
    <rect x="-8" y="-12" width="16" height="14" rx="2" fill="#B08D57" />
    <circle cx="0" cy="28" r="110" fill="url(#edison-glow)" />
    <ellipse cx="0" cy="16" rx="13" ry="20" fill="#FFF8E1" opacity="0.9" />
    <path d="M -4 6 L 0 20 L 4 6" stroke="#FF6F00" stroke-width="2" fill="none" />
  </g>

  <!-- Bulb 4 (Far right) -->
  <g transform="translate(1450, 240)">
    <line x1="0" y1="-70" x2="0" y2="0" stroke="#120A05" stroke-width="2" />
    <circle cx="0" cy="25" r="85" fill="url(#edison-glow)" />
    <ellipse cx="0" cy="14" rx="10" ry="16" fill="#FFF8E1" opacity="0.85" />
  </g>

  <!-- Outdoor Evening Seating under the lights -->
  <!-- Warm Illuminated Table & Stools -->
  <g id="evening-table" transform="translate(760, 750)">
    <!-- Pool of light on gravel -->
    <ellipse cx="0" cy="120" rx="360" ry="90" fill="url(#edison-glow)" opacity="0.5" />

    <!-- Table pedestal -->
    <rect x="-18" y="20" width="36" height="110" fill="#18110B" />
    <!-- Table top (Warm orange-terracotta hue reflecting bulbs) -->
    <ellipse cx="0" cy="20" rx="260" ry="65" fill="#E65100" stroke="#FFB74D" stroke-width="4" />

    <!-- Cutting chai glasses on table -->
    <g transform="translate(-80, -10)">
      <polygon points="-12,0 -8,30 8,30 12,0" fill="rgba(255,255,255,0.7)" stroke="#FFE082" stroke-width="1.5" />
      <polygon points="-10,10 -7,28 7,28 10,10" fill="#D97706" />
      <!-- Delicate steam -->
      <path d="M -2 -2 Q 2 -12 -2 -22" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" fill="none" />
    </g>
    <g transform="translate(-40, 5)">
      <polygon points="-12,0 -8,30 8,30 12,0" fill="rgba(255,255,255,0.7)" stroke="#FFE082" stroke-width="1.5" />
      <polygon points="-10,10 -7,28 7,28 10,10" fill="#D97706" />
      <path d="M 2 0 Q -2 -10 2 -20" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" fill="none" />
    </g>

    <!-- Table lantern -->
    <rect x="70" y="-12" width="24" height="34" rx="4" fill="rgba(255,255,255,0.3)" stroke="#5D4037" stroke-width="2" />
    <circle cx="82" cy="5" r="16" fill="url(#edison-glow)" />

    <!-- Yellow and white chairs bathed in warm light -->
    <path d="M -240 10 C -260 50, -230 90, -200 100 L -160 100" fill="#FFC107" stroke="#FFA000" stroke-width="3" />
    <path d="M 200 10 C 220 50, 190 90, 160 100 L 120 100" fill="#ECEFF1" stroke="#CFD8DC" stroke-width="3" />
  </g>

  <!-- Potted tropical plants in the foreground -->
  <g transform="translate(120, 720)">
    <path d="M 0 120 C 40 40, 100 20, 140 80 C 100 100, 60 110, 0 130 Z" fill="#1B5E20" />
    <path d="M 0 160 C 60 100, 140 120, 180 180 C 120 190, 60 180, 0 170 Z" fill="#2E7D32" />
  </g>
  <g transform="translate(1420, 740)">
    <path d="M 0 100 C -40 20, -100 30, -140 90 C -90 110, -50 110, 0 110 Z" fill="#1B5E20" />
  </g>

  <!-- Subtle ambient glow overlay -->
  <rect width="1600" height="1000" fill="url(#edison-glow)" opacity="0.1" style="mix-blend-mode: screen;" />
</svg>
